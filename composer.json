{
  "name": "teknasyon/crond",
  "description": "Distributed Cron Worker",
  "keywords": [
    "cron",
    "cronjob",
    "crond",
    "worker",
    "php",
    "teknasyon",
    "redis",
    "lock"
  ],
  "homepage": "https://github.com/teknasyon-teknoloji/crond",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Fatih Ustundag",
      "email": "fatih.ustundag@gmail.com",
      "homepage": "http://fatihustundag.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "dragonmantank/cron-expression": "^3.5",
    "psr/log": "^2.0 || ^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0 || ^13.0",
    "ext-redis": "*"
  },
  "autoload": {
    "psr-4": {
      "Teknasyon\\Crond\\": "src/"
    }
  },
  "suggest": {
    "ext-redis": "Required to use RedisLocker"
  },
  "scripts": {
    "test": "phpunit -c tests/unit/phpunit.xml"
  },
  "extra": {
    "branch-alias": {
      "dev-master": "2.3.x-dev"
    }
  },
  "support": {
    "issues": "https://github.com/Teknasyon-Teknoloji/crond/issues",
    "source": "https://github.com/Teknasyon-Teknoloji/crond"
  }
}
